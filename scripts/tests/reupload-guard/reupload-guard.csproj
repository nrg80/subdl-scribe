  invariant globalization is right here.
  Run it with: dotnet run -c Release, project scripts/tests/reupload-guard/reupload-guard.csproj
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>reuploadguard</AssemblyName>
    <RootNamespace>ReuploadGuard</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1305;CA1307;CA1862</NoWarn>
    <JellyfinDir Condition="'$(JellyfinDir)' == ''">/opt/data/jf-test/jellyfin</JellyfinDir>
    <PluginDir Condition="'$(PluginDir)' == ''">/opt/data/subdl-scribe/Jellyfin.Plugin.SubdlSync/bin/Release/net10.0</PluginDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Jellyfin.Plugin.SubdlSync"><HintPath>$(PluginDir)/Jellyfin.Plugin.SubdlSync.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Common"><HintPath>$(JellyfinDir)/MediaBrowser.Common.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Controller"><HintPath>$(JellyfinDir)/MediaBrowser.Controller.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Model"><HintPath>$(JellyfinDir)/MediaBrowser.Model.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>$(JellyfinDir)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath></Reference>
    <!-- Section 6 of T153 opens a REAL store, so the plugin's own dependency set has to sit beside the
         test assembly: EF Core and its SQLite provider ship with the plugin, not with the SDK. -->
    <None Include="$(PluginDir)/*.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PluginDir)/runtimes/**/*">
      <Link>runtimes/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
