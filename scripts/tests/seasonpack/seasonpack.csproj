  Store-free except one probe: this exercises the season-pack arithmetic and the
  container bytes as pure objects — no HTTP, no database, no library. The single
  exception is the F-M650 check, which opens a THROWAWAY store in a temp folder
  (a remembered refusal only exists as a packs row) and deletes it again.
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>seasonpackrun</AssemblyName>
    <RootNamespace>SeasonPackRun</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1305;CA1307;CA1862</NoWarn>
    <JellyfinDir Condition="'$(JellyfinDir)' == ''">/opt/data/jf-test/jellyfin</JellyfinDir>
    <PluginDir Condition="'$(PluginDir)' == ''">/opt/data/subdl-scribe/Jellyfin.Plugin.SubdlSync/bin/Release/net10.0</PluginDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Jellyfin.Plugin.SubdlSync"><HintPath>$(PluginDir)/Jellyfin.Plugin.SubdlSync.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Common"><HintPath>$(JellyfinDir)/MediaBrowser.Common.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Controller"><HintPath>$(JellyfinDir)/MediaBrowser.Controller.dll</HintPath></Reference>
    <Reference Include="MediaBrowser.Model"><HintPath>$(JellyfinDir)/MediaBrowser.Model.dll</HintPath></Reference>
    <Reference Include="Microsoft.Extensions.Logging.Abstractions"><HintPath>$(JellyfinDir)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath></Reference>
    <!-- F-M650: der Harness oeffnet fuer das Ablehnungs-Tor einen ECHTEN Store in einem temporaeren
         Ordner (eine gemerkte Absage ist nur mit einer packs-Zeile pruefbar). Dafuer muessen der
         SQLite-Provider und die uebrigen EF-Bausteine mit — dieselbe Liste wie in storex. -->
    <Reference Include="Microsoft.EntityFrameworkCore"><HintPath>$(JellyfinDir)/Microsoft.EntityFrameworkCore.dll</HintPath></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Abstractions"><HintPath>$(JellyfinDir)/Microsoft.EntityFrameworkCore.Abstractions.dll</HintPath></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Relational"><HintPath>$(JellyfinDir)/Microsoft.EntityFrameworkCore.Relational.dll</HintPath></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Sqlite"><HintPath>$(JellyfinDir)/Microsoft.EntityFrameworkCore.Sqlite.dll</HintPath></Reference>
    <Reference Include="Microsoft.Data.Sqlite"><HintPath>$(JellyfinDir)/Microsoft.Data.Sqlite.dll</HintPath></Reference>
    <Reference Include="SQLitePCLRaw.core"><HintPath>$(JellyfinDir)/SQLitePCLRaw.core.dll</HintPath></Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3"><HintPath>$(JellyfinDir)/SQLitePCLRaw.provider.e_sqlite3.dll</HintPath></Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2"><HintPath>$(JellyfinDir)/SQLitePCLRaw.batteries_v2.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Der Store braucht die native SQLite-Bibliothek; ohne diesen Verweis stirbt der Lauf im
         DbContext-Konstruktor (EnsureCreated). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>
</Project>
