<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>seed-db-test</AssemblyName>
    <RootNamespace>SeedDbTest</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Jellyfin's own assemblies. Point this elsewhere with:
           dotnet run -p:JellyfinDir=/path/to/jellyfin -->
    <JellyfinDir Condition="'$(JellyfinDir)' == ''">/opt/data/jf-test/jellyfin</JellyfinDir>
    <!-- The plugin under test. Default = the normal build output, so the test
         checks what `dotnet build` just produced. Point it at an EXTRACTED
         release zip to check a shipped artifact instead:
           dotnet run -p:PluginDir=/tmp/pub137 -->
    <PluginDir Condition="'$(PluginDir)' == ''">$(MSBuildThisFileDirectory)../../Jellyfin.Plugin.SubdlSync/bin/Release/net10.0</PluginDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Jellyfin.Plugin.SubdlSync">
      <HintPath>$(PluginDir)/Jellyfin.Plugin.SubdlSync.dll</HintPath>
    </Reference>
    <Reference Include="MediaBrowser.Common">
      <HintPath>$(JellyfinDir)/MediaBrowser.Common.dll</HintPath>
    </Reference>
    <Reference Include="MediaBrowser.Controller">
      <HintPath>$(JellyfinDir)/MediaBrowser.Controller.dll</HintPath>
    </Reference>
    <Reference Include="MediaBrowser.Model">
      <HintPath>$(JellyfinDir)/MediaBrowser.Model.dll</HintPath>
    </Reference>
    <Reference Include="LiteDB">
      <HintPath>$(PluginDir)/LiteDB.dll</HintPath>
    </Reference>
    <!-- The registry's constructors take an ILogger; the plugin resolves it from
         Jellyfin's host at runtime, so the test needs the abstraction directly. -->
    <Reference Include="Microsoft.Extensions.Logging.Abstractions">
      <HintPath>$(JellyfinDir)/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
    </Reference>
    <!-- PRE-EXISTING GAP, fixed here: the store moved to SQLite and `migrate` grew these
         references, but seed-db-test kept the LiteDB list alone. The suite therefore built
         cleanly and died at its FIRST SubdlDbContext construction with
         `Could not load file or assembly 'Microsoft.Data.Sqlite'` — a missing Reference in
         this csproj, not a broken test. Without them no run reaches any check, so the suite
         could not verify anything at all. -->
    <Reference Include="Microsoft.EntityFrameworkCore"><HintPath>$(JellyfinDir)/Microsoft.EntityFrameworkCore.dll</HintPath></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Abstractions"><HintPath>$(JellyfinDir)/Microsoft.EntityFrameworkCore.Abstractions.dll</HintPath></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Relational"><HintPath>$(JellyfinDir)/Microsoft.EntityFrameworkCore.Relational.dll</HintPath></Reference>
    <Reference Include="Microsoft.EntityFrameworkCore.Sqlite"><HintPath>$(JellyfinDir)/Microsoft.EntityFrameworkCore.Sqlite.dll</HintPath></Reference>
    <Reference Include="Microsoft.Data.Sqlite"><HintPath>$(JellyfinDir)/Microsoft.Data.Sqlite.dll</HintPath></Reference>
    <Reference Include="SQLitePCLRaw.core"><HintPath>$(JellyfinDir)/SQLitePCLRaw.core.dll</HintPath></Reference>
    <Reference Include="SQLitePCLRaw.provider.e_sqlite3"><HintPath>$(JellyfinDir)/SQLitePCLRaw.provider.e_sqlite3.dll</HintPath></Reference>
    <Reference Include="SQLitePCLRaw.batteries_v2"><HintPath>$(JellyfinDir)/SQLitePCLRaw.batteries_v2.dll</HintPath></Reference>
  </ItemGroup>
  <!-- The M11-M13 checks read the pipeline SOURCE, not the compiled DLL: a hard-coded literal
       is invisible in IL, so the source has to be next to the binary. Copied here rather than by
       hand — a manual step is one a later run forgets, and the check would then pass by absence.
       (M10 fails loudly if this file is missing, so the silence cannot spread.) -->
  <Target Name="CopyPipelineSourceForStructuralChecks" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../Jellyfin.Plugin.SubdlSync/Pipeline/DownloadPipeline.cs"
          DestinationFiles="$(OutDir)DownloadPipeline.source.cs"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)../../Jellyfin.Plugin.SubdlSync/Pipeline/UploadPipeline.cs"
          DestinationFiles="$(OutDir)UploadPipeline.source.cs"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
