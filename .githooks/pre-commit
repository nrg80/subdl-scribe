#!/bin/sh
# Cliff: code commits belong on develop. main takes merges and "release:" commits only.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  subject=$(head -1 "$1" 2>/dev/null)
  case "$subject" in
    release:*|Merge\ *|merge:*) ;;
    *)
      echo "ABORT: '$branch' ist der Release-Zweig. Code gehoert auf develop (F-M-Konvention)." >&2
      echo "       Wechsle mit: git checkout develop" >&2
      exit 1
      ;;
  esac
fi
exit 0
